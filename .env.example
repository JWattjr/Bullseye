# Local single-process persistence; keep this outside public/.
BULLSEYE_DATA_DIR=.data
# Hosted preview: save guest practice and finalized public projections in browser.
# Set at BOTH build and runtime. No operator key is needed by the web app.
NEXT_PUBLIC_PRACTICE_STORAGE=browser
# Deployment scripts use the already configured GenLayer CLI account.
BULLSEYE_STEP=proof
# Optional only when bootstrapping a fresh manifest.
BULLSEYE_CONTRACT=
