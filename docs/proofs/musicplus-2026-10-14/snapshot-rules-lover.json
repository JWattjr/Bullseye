        "calldata": {
          "readable": "{\"args\":[\"snapshot-rules-lover\",\"https://web.archive.org/web/20211010140829id_/https://www.billboard.com/articles/business/chart-beat/8528870/taylor-swift-lover-album-debuts-at-no-1-on-billboard-200-chart/\",]\"method\":\"snapshot\"}"
