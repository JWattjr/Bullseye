    "    require(spec['metric'] == 'domestic opening-weekend box-office revenue', 'exact metric required')\n" +
    "    require(isinstance(spec['source_url'], str) and re.fullmatch(r'https://www\\.the-numbers\\.com/movie/[A-Za-z0-9()%-]+', spec['source_url']) is not None, 'unapproved source')\n" +
    "    require(spec['geography'] == 'United States and Canada', 'domestic scope required')\n" +
    "    require(spec['currency'] == 'USD' and spec['unit'] == 'dollars' and type(spec['scale']) is int and spec['scale'] == 1, 'wrong units')\n" +
    "    require(spec['rounding'] == 'exact published integer; no rounding', 'rounding')\n" +
    "    require(spec['correction_policy'] == POLICY and spec['missing_evidence'] == 'pending until deadline then void', 'evidence policy')\n" +
