    "        gl.get_contract_at(gl.message.contract_address).emit(on='finalized').open_round(round_id, record['specification_hash'])\n" +
    '\n' +
    '    @gl.public.write\n' +
    '    def open_round(self, round_id: str, specification_hash: str) -> None:\n' +
