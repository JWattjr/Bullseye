    '"""Deterministic Billboard 200 extraction. Never pass page HTML to a model.\r\n' +
    '\r\n' +
    'This module is kept separately so the saved source fixture can exercise the\r\n' +
    'same parser that will be bundled into the deployed intelligent contract.\r\n' +
    '"""\r\n' +
    'import hashlib\r\n' +
    'import json\r\n' +
    'import re\r\n' +
    'from html.parser import HTMLParser\r\n' +
    '\r\n' +
    '\r\n' +
    'class ChartRows(HTMLParser):\r\n' +
    '    def __init__(self):\r\n' +
    '        super().__init__(convert_charrefs=True)\r\n' +
    '        self.depth = 0\r\n' +
    '        self.cells = []\r\n' +
    '        self.collectors = []\r\n' +
    '        self.rows = []\r\n' +
    '\r\n' +
    '    def handle_starttag(self, tag, attrs):\r\n' +
    "        classes = dict(attrs).get('class', '').split()\r\n" +
    '        if not self.depth:\r\n' +
    "            if tag == 'div' and 'o-chart-results-list-row-container' in classes:\r\n" +
    '                self.depth = 1\r\n' +
    '                self.cells = []\r\n' +
    '                self.collectors = []\r\n' +
    '            return\r\n' +
    "        if tag == 'div':\r\n" +
    '            self.depth += 1\r\n' +
    "        if tag in ('span', 'h3'):\r\n" +
    "            self.collectors.append({'tag': tag, 'classes': classes, 'text': []})\r\n" +
    '\r\n' +
    '    def handle_data(self, data):\r\n' +
    '        for collector in self.collectors:\r\n' +
    "            collector['text'].append(data)\r\n" +
    '\r\n' +
    '    def handle_endtag(self, tag):\r\n' +
    '        if not self.depth:\r\n' +
    '            return\r\n' +
    "        if tag in ('span', 'h3') and self.collectors:\r\n" +
    '            # Close the nearest matching text element, retaining nested text.\r\n' +
    '            for index in range(len(self.collectors) - 1, -1, -1):\r\n' +
    "                if self.collectors[index]['tag'] == tag:\r\n" +
    '                    collector = self.collectors.pop(index)\r\n' +
    "                    value = ' '.join(''.join(collector['text']).split())\r\n" +
    "                    self.cells.append((tag, collector['classes'], value))\r\n" +
    '                    break\r\n' +
    "        if tag == 'div':\r\n" +
    '            self.depth -= 1\r\n' +
    '            if not self.depth:\r\n' +
    '                self.rows.append(self.cells)\r\n' +
    '                self.collectors = []\r\n' +
    '\r\n' +
    '\r\n' +
    'def integer(value, low, high):\r\n' +
    "    if not re.fullmatch(r'[0-9]+', value):\r\n" +
