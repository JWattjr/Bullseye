{
  code: '# { "Depends": "py-genlayer:1jb45aa8ynh2a9c9xn3b7qqh8sm5q93hwfp7jqmwsfhh8jpz09h6" }\r\n' +
    '"""Zero-value StudioNet access diagnostic, not a market or settlement oracle."""\r\n' +
    'import json\r\n' +
    'import re\r\n' +
    'from genlayer import *\r\n' +
    '\r\n' +
    "HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/130.0.0.0 Safari/537.36', 'Accept': 'text/html,application/json;q=0.9,*/*;q=0.8'}\r\n" +
    '\r\n' +
    '"""Deterministic Billboard 200 extraction. Never pass page HTML to a model.\r\n' +
    '\r\n' +
    'This module is kept separately so the saved source fixture can exercise the\r\n' +
    'same parser that will be bundled into the deployed intelligent contract.\r\n' +
    '"""\r\n' +
    'import hashlib\r\n' +
    'import json\r\n' +
    'import re\r\n' +
    'from html.parser import HTMLParser\r\n' +
    '\r\n' +
    '\r\n' +
    'class ChartRows(HTMLParser):\r\n' +
    '    def __init__(self):\r\n' +
    '        super().__init__(convert_charrefs=True)\r\n' +
    '        self.depth = 0\r\n' +
    '        self.cells = []\r\n' +
    '        self.collectors = []\r\n' +
    '        self.rows = []\r\n' +
    '\r\n' +
    '    def handle_starttag(self, tag, attrs):\r\n' +
    "        classes = dict(attrs).get('class', '').split()\r\n" +
    '        if not self.depth:\r\n' +
    "            if tag == 'div' and 'o-chart-results-list-row-container' in classes:\r\n" +
    '                self.depth = 1\r\n' +
    '                self.cells = []\r\n' +
    '                self.collectors = []\r\n' +
    '            return\r\n' +
    "        if tag == 'div':\r\n" +
    '            self.depth += 1\r\n' +
    "        if tag in ('span', 'h3'):\r\n" +
    "            self.collectors.append({'tag': tag, 'classes': classes, 'text': []})\r\n" +
    '\r\n' +
    '    def handle_data(self, data):\r\n' +
    '        for collector in self.collectors:\r\n' +
    "            collector['text'].append(data)\r\n" +
    '\r\n' +
    '    def handle_endtag(self, tag):\r\n' +
    '        if not self.depth:\r\n' +
    '            return\r\n' +
    "        if tag in ('span', 'h3') and self.collectors:\r\n" +
    '            # Close the nearest matching text element, retaining nested text.\r\n' +
    '            for index in range(len(self.collectors) - 1, -1, -1):\r\n' +
    "                if self.collectors[index]['tag'] == tag:\r\n" +
    '                    collector = self.collectors.pop(index)\r\n' +
    "                    value = ' '.join(''.join(collector['text']).split())\r\n" +
    "                    self.cells.append((tag, collector['classes'], value))\r\n" +
    '                    break\r\n' +
    "        if tag == 'div':\r\n" +
    '            self.depth -= 1\r\n' +
    '            if not self.depth:\r\n' +
    '                self.rows.append(self.cells)\r\n' +
    '                self.collectors = []\r\n' +
    '\r\n' +
    '\r\n' +
    'def integer(value, low, high):\r\n' +
    "    if not re.fullmatch(r'[0-9]+', value):\r\n" +
    "        raise ValueError('non-integer chart metric')\r\n" +
    '    result = int(value)\r\n' +
    '    if not low <= result <= high:\r\n' +
    "        raise ValueError('chart metric outside bounds')\r\n" +
    '    return result\r\n' +
    '\r\n' +
    '\r\n' +
    'def extract_rows(page):\r\n' +
    '    parser = ChartRows()\r\n' +
    '    parser.feed(page)\r\n' +
    '    parser.close()\r\n' +
    '    if parser.depth or len(parser.rows) != 200:\r\n' +
    "        raise ValueError('complete 200-row chart required')\r\n" +
    '    rows = []\r\n' +
    '    for cells in parser.rows:\r\n' +
    '        values = [cell[2] for cell in cells if cell[2]]\r\n' +
    '        position = integer(values[0], 1, 200)\r\n' +
    '        titles = [text for tag, classes, text in cells\r\n' +
    "                  if tag == 'h3' and 'a-truncate-ellipsis-2line' in classes]\r\n" +
    '        artists = [text for tag, classes, text in cells\r\n' +
    "                   if tag == 'span' and 'a-no-trucate' in classes]\r\n" +
    '        if len(titles) != 1 or len(artists) != 1:\r\n' +
    "            raise ValueError('ambiguous chart row markup')\r\n" +
    '        title, artist = titles[0], artists[0]\r\n' +
    '        if not 1 <= len(title) <= 200 or not 1 <= len(artist) <= 300:\r\n' +
    "            raise ValueError('unbounded chart identity')\r\n" +
    '        def metric(label):\r\n' +
    '            matches = [values[index + 1] for index, text in enumerate(values[:-1])\r\n' +
    '                       if text == label]\r\n' +
    '            if not matches or len(set(matches)) != 1:\r\n' +
    "                raise ValueError('missing or inconsistent chart metric')\r\n" +
    '            return matches[0]\r\n' +
    "        last = metric('LW')\r\n" +
    "        last_week = None if last in ('-', '—') else integer(last, 1, 200)\r\n" +
    "        weeks = integer(metric('WEEKS ON CHART'), 1, 10000)\r\n" +
    "        rows.append({'position': position, 'title': title, 'artist': artist,\r\n" +
    "                     'last_week': last_week, 'weeks': weeks})\r\n" +
    "    if [row['position'] for row in rows] != list(range(1, 201)):\r\n" +
    "        raise ValueError('ordered unique positions 1 through 200 required')\r\n" +
    '    return rows\r\n' +
    '\r\n' +
    '\r\n' +
    'def rows_digest(rows):\r\n' +
    '    encoded = json.dumps(rows, ensure_ascii=False, sort_keys=True,\r\n' +
    "                         separators=(',', ':')).encode('utf-8')\r\n" +
    '    return hashlib.sha256(encoded).hexdigest()\r\n' +
    '\r\n' +
    '\r\n' +
    'def row_quote(row):\r\n' +
    "    last = '—' if row['last_week'] is None else str(row['last_week'])\r\n" +
    "    return ('#' + str(row['position']) + ' | ' + row['title'] + ' | '\r\n" +
    "            + row['artist'] + ' | LW: ' + last + ' | Weeks: ' + str(row['weeks']))\r\n" +
    '\r\n' +
    '\r\n' +
    'class MusicRowsAccessProbe(gl.Contract):\r\n' +
    '    owner: Address\r\n' +
    '    results: TreeMap[str, str]\r\n' +
    '\r\n' +
    '    def __init__(self):\r\n' +
    '        self.owner = gl.message.sender_address\r\n' +
    '\r\n' +
    '    @gl.public.write\r\n' +
    '    def probe(self, name: str, url: str) -> None:\r\n' +
    '        if gl.message.sender_address != self.owner:\r\n' +
    "            raise gl.vm.UserError('[EXPECTED] diagnostic owner only')\r\n" +
    "        if not re.fullmatch(r'[a-z0-9-]{1,64}', name) or len(url) > 1000:\r\n" +
    "            raise gl.vm.UserError('[EXPECTED] bounded diagnostic')\r\n" +
    "        direct = re.fullmatch(r'https://www\\.billboard\\.com/charts/billboard-200/[0-9]{4}-[0-9]{2}-[0-9]{2}/', url)\r\n" +
    "        index = url.startswith('https://web.archive.org/cdx/search/cdx?url=') and 'billboard' in url\r\n" +
    "        capture = re.fullmatch(r'https://web\\.archive\\.org/web/[0-9]{14}id_/https?://(?:www\\.)?billboard\\.com/charts/billboard-200/[0-9]{4}-[0-9]{2}-[0-9]{2}/?', url)\r\n" +
    '        if not (direct or index or capture):\r\n' +
    "            raise gl.vm.UserError('[EXPECTED] Billboard 200 and Wayback only')\r\n" +
    '        def fetch():\r\n' +
    '            response = gl.nondet.web.get(url, headers=HEADERS)\r\n' +
    "            body = response.body.decode('utf-8', errors='replace')\r\n" +
    "            chart = 'o-chart-results-list-row-container' in body\r\n" +
    '            captures = 0\r\n' +
    "            first = ''\r\n" +
    '            if index and response.status == 200:\r\n' +
    '                try:\r\n' +
    '                    rows = json.loads(body)\r\n' +
    '                    captures = max(0, len(rows) - 1) if isinstance(rows, list) else 0\r\n' +
    "                    first = str(rows[1][0]) if captures else ''\r\n" +
    '                except (ValueError, TypeError, IndexError):\r\n' +
    '                    pass\r\n' +
    "            row_count = body.count('o-chart-results-list-row-container')\r\n" +
    "            digest = ''\r\n" +
    "            error = ''\r\n" +
    '            first_row = {}\r\n' +
    '            last_row = {}\r\n' +
    '            if chart:\r\n' +
    '                try:\r\n' +
    '                    extracted = extract_rows(body)\r\n' +
    '                    digest = rows_digest(extracted)\r\n' +
    '                    first_row, last_row = extracted[0], extracted[-1]\r\n' +
    '                except ValueError as failure:\r\n' +
    '                    error = str(failure)\r\n' +
    "            return {'row_containers': row_count, 'rows_digest': digest,\r\n" +
    "                    'extraction_error': error, 'first_row': first_row, 'last_row': last_row,\r\n" +
    "                    'status': response.status, 'chart_markup': chart,\r\n" +
    "                    'capture_count': captures, 'first_capture': first,\r\n" +
    "                    'body_bytes': len(response.body), 'sample': body[:160]}\r\n" +
    '        def verify(leader):\r\n' +
    '            if not isinstance(leader, gl.vm.Return):\r\n' +
    '                return False\r\n' +
    '            independent = fetch()\r\n' +
    '            proposed = leader.calldata\r\n' +
    '            # Availability only: changing ads/HTML length do not prove a chart\r\n' +
    '            # mismatch. Product resolution must compare complete extracted rows.\r\n' +
    '            return all(independent[k] == proposed[k] for k in\r\n' +
    "                       ('status', 'chart_markup', 'capture_count', 'first_capture', 'rows_digest', 'extraction_error', 'row_containers'))\r\n" +
    '        self.results[name] = json.dumps(gl.vm.run_nondet_unsafe(fetch, verify), sort_keys=True)\r\n' +
    '\r\n' +
    '    @gl.public.view\r\n' +
    '    def get_result(self, name: str) -> str:\r\n' +
    "        return self.results.get(name, '')\r\n",
  args: [],
  leaderOnly: false
}

