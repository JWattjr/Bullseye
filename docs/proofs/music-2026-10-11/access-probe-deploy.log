
Deployment Parameters:
{
  code: '# { "Depends": "py-genlayer:1jb45aa8ynh2a9c9xn3b7qqh8sm5q93hwfp7jqmwsfhh8jpz09h6" }\n' +
    '"""Zero-value StudioNet access diagnostic, not a market or settlement oracle."""\n' +
    'import json\n' +
    'import re\n' +
    'from genlayer import *\n' +
    '\n' +
    "HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/130.0.0.0 Safari/537.36', 'Accept': 'text/html,application/json;q=0.9,*/*;q=0.8'}\n" +
    '\n' +
    'class MusicAccessProbe(gl.Contract):\n' +
    '    owner: Address\n' +
    '    results: TreeMap[str, str]\n' +
    '\n' +
    '    def __init__(self):\n' +
    '        self.owner = gl.message.sender_address\n' +
    '\n' +
    '    @gl.public.write\n' +
    '    def probe(self, name: str, url: str) -> None:\n' +
    '        if gl.message.sender_address != self.owner:\n' +
    "            raise gl.vm.UserError('[EXPECTED] diagnostic owner only')\n" +
    "        if not re.fullmatch(r'[a-z0-9-]{1,64}', name) or len(url) > 1000:\n" +
    "            raise gl.vm.UserError('[EXPECTED] bounded diagnostic')\n" +
    "        direct = re.fullmatch(r'https://www\\.billboard\\.com/charts/billboard-200/[0-9]{4}-[0-9]{2}-[0-9]{2}/', url)\n" +
    "        index = url.startswith('https://web.archive.org/cdx/search/cdx?url=') and 'billboard' in url\n" +
    "        capture = re.fullmatch(r'https://web\\.archive\\.org/web/[0-9]{14}id_/https?://(?:www\\.)?billboard\\.com/charts/billboard-200/[0-9]{4}-[0-9]{2}-[0-9]{2}/?', url)\n" +
    '        if not (direct or index or capture):\n' +
    "            raise gl.vm.UserError('[EXPECTED] Billboard 200 and Wayback only')\n" +
    '        def fetch():\n' +
    '            response = gl.nondet.web.get(url, headers=HEADERS)\n' +
    "            body = response.body.decode('utf-8', errors='replace')\n" +
    "            chart = 'o-chart-results-list-row-container' in body\n" +
    '            captures = 0\n' +
    "            first = ''\n" +
    '            if index and response.status == 200:\n' +
    '                try:\n' +
    '                    rows = json.loads(body)\n' +
    '                    captures = max(0, len(rows) - 1) if isinstance(rows, list) else 0\n' +
    "                    first = str(rows[1][0]) if captures else ''\n" +
    '                except (ValueError, TypeError, IndexError):\n' +
    '                    pass\n' +
    "            return {'status': response.status, 'chart_markup': chart,\n" +
    "                    'capture_count': captures, 'first_capture': first,\n" +
    "                    'body_bytes': len(response.body), 'sample': body[:160]}\n" +
    '        def verify(leader):\n' +
    '            if not isinstance(leader, gl.vm.Return):\n' +
    '                return False\n' +
    '            independent = fetch()\n' +
    '            proposed = leader.calldata\n' +
    '            # Availability only: changing ads/HTML length do not prove a chart\n' +
    '            # mismatch. Product resolution must compare complete extracted rows.\n' +
    '            return all(independent[k] == proposed[k] for k in\n' +
    "                       ('status', 'chart_markup', 'capture_count', 'first_capture'))\n" +
    '        self.results[name] = json.dumps(gl.vm.run_nondet_unsafe(fetch, verify), sort_keys=True)\n' +
    '\n' +
    '    @gl.public.view\n' +
    '    def get_result(self, name: str) -> str:\n' +
    "        return self.results.get(name, '')\n",
  args: [],
  leaderOnly: false
}

