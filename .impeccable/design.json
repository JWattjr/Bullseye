      "html": "<details class=\"ds-disclosure\"><summary>Evidence &amp; technical record<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 5v14M5 12h14\"/></svg></summary><p>No protocol transaction for this local practice result.</p></details>",
      "css": ".ds-disclosure{border-top:1px solid var(--line,#d3d0c5);border-bottom:1px solid var(--line,#d3d0c5);font-family:'DM Sans',sans-serif;color:var(--ink,#24261f)}.ds-disclosure summary{display:flex;justify-content:space-between;gap:20px;align-items:center;cursor:pointer;padding:17px 0;font-size:13px;font-weight:500;list-style:none}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-disclosure[open] summary svg{transform:rotate(45deg)}.ds-disclosure summary:focus-visible{outline:3px solid var(--orange,#c64018);outline-offset:5px}.ds-disclosure p{font-size:12px;line-height:1.55;margin:0;padding:3px 0 22px}"
