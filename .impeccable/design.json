      "kind": "custom",
      "description": "Original pink type study; event names identify films without studio posters.",
      "html": "<div class=\"ds-art\" role=\"img\" aria-label=\"Original Bullseye typographic artwork for Barbie\"><span class=\"ds-letter\" aria-hidden=\"true\">B</span><span class=\"ds-art-title\">Barbie</span><span class=\"ds-art-note\">BULLSEYE ORIGINAL / TYPE STUDY</span><span class=\"ds-ring\" aria-hidden=\"true\"></span></div>",
      "css": ".ds-art{min-height:214px;width:153px;overflow:hidden;position:relative;background:var(--pink,#eed5dc);color:#72313f;padding:17px;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end}.ds-letter{font-family:'Bebas Neue',sans-serif;font-size:240px;line-height:1;position:absolute;left:5%;top:-23px;opacity:.85;z-index:-1}.ds-art-title{font-family:'Bebas Neue',sans-serif;font-size:29px;line-height:.95;max-width:95%;background:var(--pink,#eed5dc);padding-top:6px;z-index:1}.ds-art-note{font-family:'DM Sans',sans-serif;font-size:6px;font-weight:700;letter-spacing:.08em;margin-top:12px}.ds-ring{width:97px;height:97px;border:1px solid currentColor;border-radius:50%;position:absolute;right:-30px;top:55px;z-index:-1}"
