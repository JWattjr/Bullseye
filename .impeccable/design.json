      "html": "<button class=\"ds-music-outcome\" aria-pressed=\"true\"><span>✓ <strong>#1</strong></span><span><strong>0 GEN</strong><small>1 free prediction</small></span></button>",
      "css": ".ds-music-outcome{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:72px;width:100%;padding:18px;border:1px solid #ad3817;border-radius:6px;background:#f4dfd4;color:var(--ink,#24261f);font-family:\"DM Sans\",sans-serif;text-align:left;cursor:pointer}.ds-music-outcome>span:first-child strong{font-size:1.5rem}.ds-music-outcome>span:last-child{text-align:right}.ds-music-outcome small{display:block;font-size:.7rem;color:#525448;margin-top:5px}.ds-music-outcome:hover:not(:disabled){border-color:#ad3817}.ds-music-outcome:disabled{cursor:default;opacity:.75}.ds-music-outcome:focus-visible{outline:2px solid #ad3817;outline-offset:4px}@media(prefers-reduced-motion:no-preference){.ds-music-outcome{transition:background-color .16s ease-out,border-color .16s ease-out}}"
